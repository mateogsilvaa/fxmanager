rules_version = '2';
// FX Manager · Hyper Race X1
// Partida original en las colecciones raíz + partidas de amigos en partidas/{pid}/...
// Pega este archivo en Firebase Console > Firestore Database > Reglas > Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(uid())).data; }
    function esAdmin() { return autenticado() && exists(/databases/$(database)/documents/usuarios/$(uid())) && perfil().get('isAdmin', false) == true; }
    function ahora() { return request.time.toMillis(); }
    // Miembro de la liga original: administración, cuentas aprobadas o con escudería. La liga original es privada.
    function miembroOriginal() {
      return autenticado() && exists(/databases/$(database)/documents/usuarios/$(uid()))
        && (perfil().get('isAdmin', false) == true || perfil().get('estado', '') == 'aprobado' || perfil().get('equipoId', null) != null);
    }
    function config() { return get(/databases/$(database)/documents/config/juego).data; }
    function duenoDe(equipoId) { return autenticado() && get(/databases/$(database)/documents/equipos/$(equipoId)).data.ownerId == uid(); }
    // Escudería que el admin dirige en secreto (modo sombra): nadie más la puede reclamar
    function esSombra(equipoId) { return exists(/databases/$(database)/documents/secreto/sombra) && get(/databases/$(database)/documents/secreto/sombra).data.get('equipoId', '') == equipoId; }
    function soloCambian(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // ---------- Público ----------
    match /config/juego { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    match /catalogo/{id} { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    match /resumen/{id} { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    match /eventos/{id} { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    match /pilotos/{id} { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    match /mercado/{id} { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    match /mercado_ofertas/{id} { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    // Historial público de los mánagers (rating por temporada)
    match /managers/{id} { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    // Ingenieros (plantilla pública) y negociaciones entre escuderías (solo las ven las dos partes)
    match /ingenieros/{id} { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    // Juntas de pilotos: públicas (las consignas de cada mánager van en juntas_votos, solo servidor)
    match /juntas/{id} { allow read: if miembroOriginal(); allow write: if esAdmin(); }
    match /negociaciones/{id} {
      allow read: if esAdmin() || (resource != null && autenticado() && uid() in resource.data.get('uids', []));
      allow write: if esAdmin();
    }
    // Llamadas y cartas: solo su mánager las ve y solo puede elegir una respuesta mientras está disponible
    match /llamadas/{id} {
      allow read: if esAdmin() || resource == null || (autenticado() && resource.data.uid == uid());
      allow update: if esAdmin() || (
        autenticado() && resource.data.uid == uid() && soloCambian(['eleccion'])
        && resource.data.eleccion == null && resource.data.aplicada == false
        && resource.data.disponible <= ahora() && resource.data.expira > ahora()
      );
      allow create, delete: if esAdmin();
    }

    // Resultados: se guardan antes y solo se pueden leer a partir de su hora de publicación
    match /resultados/{id} {
      allow read: if esAdmin() || (miembroOriginal() && resource != null && resource.data.publishAt <= ahora());
      allow write: if esAdmin();
    }
    match /noticias/{id} {
      allow read: if esAdmin() || (miembroOriginal() && resource.data.publishAt <= ahora());
      allow write: if esAdmin();
    }

    // Equipos: públicos. Un usuario sin equipo puede reclamar uno libre si la inscripción está abierta.
    match /equipos/{equipoId} {
      allow read: if miembroOriginal();
      allow update: if esAdmin() || (
        autenticado()
        && resource.data.get('ownerId', null) == null
        && resource.data.get('grupo', null) == null
        && resource.data.get('filialDe', null) == null
        && !esSombra(equipoId)
        && request.resource.data.ownerId == uid()
        && soloCambian(['ownerId', 'ownerNombre'])
        && config().inscripcion == true
        && (perfil().get('estado', '') == 'aprobado' || perfil().get('isAdmin', false) == true)
        && perfil().get('equipoId', null) == null
        && getAfter(/databases/$(database)/documents/usuarios/$(uid())).data.equipoId == equipoId
      );
      allow create, delete: if esAdmin();
    }

    // Privado del equipo: solo su mánager lo lee; solo el servidor lo escribe
    match /equipos_priv/{equipoId} {
      allow read: if esAdmin() || duenoDe(equipoId);
      allow write: if esAdmin();
    }
    match /pilotos_priv/{pilotoId} {
      allow read: if esAdmin() || (resource != null && duenoDe(resource.data.equipoId));
      allow write: if esAdmin();
    }

    // Usuarios
    match /usuarios/{userId} {
      allow read: if autenticado() && (uid() == userId || esAdmin());
      allow create: if autenticado() && uid() == userId
        && request.resource.data.isAdmin == false
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'isAdmin', 'equipoId', 'estado', 'creado'])
        && request.resource.data.equipoId == null
        && request.resource.data.estado in ['pendiente', 'publico'];
      allow update: if esAdmin() || (
        autenticado() && uid() == userId && (
          (soloCambian(['nombre']) && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40)
          || (soloCambian(['partidas']) && request.resource.data.partidas is list && request.resource.data.partidas.size() <= 20)
          || (soloCambian(['ultimoAcceso']) && request.resource.data.ultimoAcceso is number)
          || soloCambian(['uso'])
          || soloCambian(['ultimoAcceso', 'uso'])
          || (soloCambian(['equipoId']) && resource.data.get('equipoId', null) == null
              && getAfter(/databases/$(database)/documents/equipos/$(request.resource.data.equipoId)).data.ownerId == uid())
        )
      );
      allow delete: if esAdmin();
    }

    // Estrategia de una sesión: solo el mánager y solo antes del cierre
    match /estrategias/{id} {
      allow read: if esAdmin() || (resource != null && resource.data.uid == uid());
      allow create, update: if esAdmin() || (
        autenticado()
        && request.resource.data.uid == uid()
        && duenoDe(request.resource.data.equipoId)
        && id == request.resource.data.eventoId + '_' + request.resource.data.tipo + '_' + request.resource.data.equipoId
        && get(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId)).data.sesiones[request.resource.data.tipo].lockAt > ahora()
      );
      allow delete: if esAdmin();
    }

    // Cola de acciones: el mánager las crea, el servidor las procesa
    match /acciones/{id} {
      allow read: if esAdmin() || (resource != null && resource.data.uid == uid());
      allow create: if autenticado()
        && request.resource.data.uid == uid()
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 40
        && request.resource.data.params is map
        && (duenoDe(request.resource.data.equipoId) || esAdmin())
        && request.resource.data.keys().hasOnly(['uid', 'equipoId', 'tipo', 'params', 'creado', 'estado']);
      allow update, delete: if esAdmin();
    }

    match /notificaciones/{id} {
      allow read: if esAdmin() || (resource != null && resource.data.uid == uid());
      allow update: if autenticado() && resource.data.uid == uid() && soloCambian(['leida']);
      allow create, delete: if esAdmin();
    }

    // Decisión del día: el mánager solo puede elegir una opción antes de que caduque
    match /decisiones/{id} {
      // resource == null: poder escuchar la decisión de hoy aunque todavía no se haya generado
      allow read: if esAdmin() || resource == null || resource.data.uid == uid();
      allow update: if esAdmin() || (
        autenticado() && resource.data.uid == uid()
        && resource.data.aplicada == false
        && resource.data.expira > ahora()
        && soloCambian(['eleccion'])
        && request.resource.data.eleccion is string
      );
      allow create, delete: if esAdmin();
    }

    // Ruedas de prensa: el mánager elige una respuesta cuando la pregunta ya está disponible y antes de que caduque
    match /prensa/{id} {
      allow read: if esAdmin() || (resource != null && resource.data.uid == uid());
      allow update: if autenticado() && resource.data.uid == uid()
        && resource.data.aplicada == false
        && resource.data.disponible <= ahora()
        && resource.data.expira > ahora()
        && soloCambian(['eleccion'])
        && request.resource.data.eleccion is string;
      allow create, delete: if esAdmin();
    }

    // Paddock: declaraciones públicas de los mánagers (una al día)
    match /paddock/{id} {
      allow read: if miembroOriginal();
      allow create: if autenticado()
        && request.resource.data.uid == uid()
        && duenoDe(request.resource.data.equipoId)
        && id == request.resource.data.dia + '_' + uid()
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 240
        && request.resource.data.fecha > ahora() - 600000 && request.resource.data.fecha < ahora() + 600000
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'equipoId', 'liga', 'texto', 'fecha', 'dia']);
      allow delete: if esAdmin() || (autenticado() && resource.data.uid == uid());
    }

    // Suscripciones a avisos en el móvil: cada uno la suya
    match /suscripciones/{userId} {
      allow read, write: if autenticado() && (uid() == userId || esAdmin());
    }

    // Solo servidor / admin
    match /secreto/{id} { allow read, write: if esAdmin(); }
    match /mercado_priv/{id} { allow read, write: if esAdmin(); }
    match /logs/{id} { allow read, write: if esAdmin(); }

    // ======================================================================
    // Partidas de amigos: partidas/{pid} (pública) y su juego en partidas/{pid}/<coleccion>/<doc>.
    // Mismas reglas que la partida original, pero la pertenencia sale de partidas/{pid}/miembros/{uid}.
    // Quien crea una partida solo la pide: la parrilla, el calendario y todo lo demás lo escribe el servidor.
    // ======================================================================
    function partidaP(pid) { return get(/databases/$(database)/documents/partidas/$(pid)).data; }
    function adminP(pid) { return autenticado() && uid() in partidaP(pid).get('admins', []); }
    function miembroP(pid) { return autenticado() && exists(/databases/$(database)/documents/partidas/$(pid)/miembros/$(uid())); }
    function fichaP(pid) { return get(/databases/$(database)/documents/partidas/$(pid)/miembros/$(uid())).data; }
    // Ver el juego de una partida: sus miembros, la administración, o cualquiera si la partida es abierta
    function lecturaP(pid) { return esAdmin() || miembroP(pid) || partidaP(pid).get('publica', false) == true; }
    function cfgP(pid) { return get(/databases/$(database)/documents/partidas/$(pid)/config/juego).data; }
    function duenoP(pid, eq) { return autenticado() && get(/databases/$(database)/documents/partidas/$(pid)/equipos/$(eq)).data.get('ownerId', null) == uid(); }

    match /partidas/{pid} {
      allow read: if true;
      allow create: if autenticado()
        && request.resource.data.creador == uid()
        && request.resource.data.estado == 'solicitada'
        && request.resource.data.keys().hasOnly(['nombre', 'creador', 'creadorNombre', 'ajustes', 'estado', 'creada', 'publica', 'descripcion'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 40
        && request.resource.data.ajustes is map
        && pid.size() >= 6 && pid.size() <= 24;
      allow update, delete: if esAdmin();

      // Público dentro de la partida
      match /config/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /catalogo/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /resumen/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /eventos/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /pilotos/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /mercado/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /mercado_ofertas/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /managers/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /ingenieros/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /juntas/{id} { allow read: if lecturaP(pid); allow write: if esAdmin(); }
      match /resultados/{id} {
        allow read: if esAdmin() || (lecturaP(pid) && resource != null && resource.data.publishAt <= ahora());
        allow write: if esAdmin();
      }
      match /noticias/{id} {
        allow read: if esAdmin() || (lecturaP(pid) && resource.data.publishAt <= ahora());
        allow write: if esAdmin();
      }

      // Miembros: te unes tú mismo si la partida es pública o con su código; luego eliges escudería
      match /miembros/{u} {
        allow read: if esAdmin() || miembroP(pid);
        allow create: if autenticado() && u == uid()
          && request.resource.data.uid == uid()
          && request.resource.data.equipoId == null
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'codigo', 'equipoId', 'unido'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
          && partidaP(pid).estado == 'activa'
          && (partidaP(pid).get('publica', false) == true
              || request.resource.data.codigo == get(/databases/$(database)/documents/partidas_priv/$(pid)).data.codigo);
        allow update: if esAdmin() || (
          autenticado() && u == uid() && soloCambian(['equipoId'])
          && resource.data.get('equipoId', null) == null
          && getAfter(/databases/$(database)/documents/partidas/$(pid)/equipos/$(request.resource.data.equipoId)).data.ownerId == uid()
        );
        allow delete: if esAdmin();
      }

      // Escuderías: un miembro sin equipo puede reclamar una libre si la inscripción está abierta
      match /equipos/{equipoId} {
        allow read: if lecturaP(pid);
        allow update: if esAdmin() || (
          autenticado()
          && resource.data.get('ownerId', null) == null
          && resource.data.get('grupo', null) == null
          && resource.data.get('filialDe', null) == null
          && request.resource.data.ownerId == uid()
          && soloCambian(['ownerId', 'ownerNombre'])
          && cfgP(pid).inscripcion == true
          && miembroP(pid)
          && fichaP(pid).get('equipoId', null) == null
          && getAfter(/databases/$(database)/documents/partidas/$(pid)/miembros/$(uid())).data.equipoId == equipoId
        );
        allow create, delete: if esAdmin();
      }
      match /equipos_priv/{equipoId} {
        allow read: if esAdmin() || duenoP(pid, equipoId);
        allow write: if esAdmin();
      }
      match /pilotos_priv/{pilotoId} {
        allow read: if esAdmin() || (resource != null && duenoP(pid, resource.data.equipoId));
        allow write: if esAdmin();
      }
      match /negociaciones/{id} {
        allow read: if esAdmin() || (resource != null && autenticado() && uid() in resource.data.get('uids', []));
        allow write: if esAdmin();
      }
      match /llamadas/{id} {
        allow read: if esAdmin() || resource == null || (autenticado() && resource.data.uid == uid());
        allow update: if esAdmin() || (
          autenticado() && resource.data.uid == uid() && soloCambian(['eleccion'])
          && resource.data.eleccion == null && resource.data.aplicada == false
          && resource.data.disponible <= ahora() && resource.data.expira > ahora()
        );
        allow create, delete: if esAdmin();
      }
      match /estrategias/{id} {
        allow read: if esAdmin() || (resource != null && resource.data.uid == uid());
        allow create, update: if esAdmin() || (
          autenticado()
          && request.resource.data.uid == uid()
          && duenoP(pid, request.resource.data.equipoId)
          && id == request.resource.data.eventoId + '_' + request.resource.data.tipo + '_' + request.resource.data.equipoId
          && get(/databases/$(database)/documents/partidas/$(pid)/eventos/$(request.resource.data.eventoId)).data.sesiones[request.resource.data.tipo].lockAt > ahora()
        );
        allow delete: if esAdmin();
      }
      match /acciones/{id} {
        allow read: if esAdmin() || (resource != null && resource.data.uid == uid());
        allow create: if autenticado()
          && request.resource.data.uid == uid()
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 40
          && request.resource.data.params is map
          && (duenoP(pid, request.resource.data.equipoId) || esAdmin())
          && request.resource.data.keys().hasOnly(['uid', 'equipoId', 'tipo', 'params', 'creado', 'estado']);
        allow update, delete: if esAdmin();
      }
      // Gestión ligera: el admin de la partida pide cambios y el servidor los valida y aplica
      match /gestion/{id} {
        allow read: if esAdmin() || adminP(pid);
        allow create: if adminP(pid)
          && request.resource.data.uid == uid()
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 30
          && request.resource.data.params is map
          && request.resource.data.keys().hasOnly(['uid', 'tipo', 'params', 'creado', 'estado']);
        allow update, delete: if esAdmin();
      }
      match /notificaciones/{id} {
        allow read: if esAdmin() || (resource != null && resource.data.uid == uid());
        allow update: if autenticado() && resource.data.uid == uid() && soloCambian(['leida']);
        allow create, delete: if esAdmin();
      }
      match /decisiones/{id} {
        allow read: if esAdmin() || resource == null || resource.data.uid == uid();
        allow update: if esAdmin() || (
          autenticado() && resource.data.uid == uid() && resource.data.aplicada == false
          && resource.data.expira > ahora() && soloCambian(['eleccion']) && request.resource.data.eleccion is string
        );
        allow create, delete: if esAdmin();
      }
      match /prensa/{id} {
        allow read: if esAdmin() || (resource != null && resource.data.uid == uid());
        allow update: if autenticado() && resource.data.uid == uid() && resource.data.aplicada == false
          && resource.data.disponible <= ahora() && resource.data.expira > ahora()
          && soloCambian(['eleccion']) && request.resource.data.eleccion is string;
        allow create, delete: if esAdmin();
      }
      match /paddock/{id} {
        allow read: if lecturaP(pid);
        allow create: if autenticado()
          && request.resource.data.uid == uid()
          && duenoP(pid, request.resource.data.equipoId)
          && id == request.resource.data.dia + '_' + uid()
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 240
          && request.resource.data.fecha > ahora() - 600000 && request.resource.data.fecha < ahora() + 600000
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'equipoId', 'liga', 'texto', 'fecha', 'dia']);
        allow delete: if esAdmin() || (autenticado() && resource.data.uid == uid());
      }
      // Todo lo demás (secretos, votos de las juntas, registros…) solo el servidor
      match /{coleccion}/{id} { allow read, write: if esAdmin(); }
    }
    // Código de invitación: solo lo ven los administradores de su partida
    match /partidas_priv/{pid} {
      allow read: if esAdmin() || adminP(pid);
      allow write: if esAdmin();
    }
    // Errores de la web: cualquiera puede dejar uno (pequeño y con forma fija); solo administración los ve
    match /errores/{id} {
      allow create: if request.resource.data.keys().hasOnly(['origen', 'partida', 'texto', 'url', 'uid', 't', 'ua'])
        && request.resource.data.origen == 'web'
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 300))
        && (!('ua' in request.resource.data) || (request.resource.data.ua is string && request.resource.data.ua.size() <= 300));
      allow read, update, delete: if esAdmin();
    }

    // Restos de la temporada anterior (para poder borrarlos desde el panel)
    match /{coleccion}/{id} {
      allow read, write: if esAdmin();
    }
  }
}
